{
  "coauthor-guard": {
    "SessionStart": [
      {
        "command": "python3 ./hooks/_agy_hook_adapter.py SessionStart bash ./hooks/coauthor-guard/check-global.sh",
        "timeout": 5,
        "type": "command"
      }
    ],
    "enabled": true
  },
  "commit-on-stop": {
    "Stop": [
      {
        "command": "python3 ./hooks/_agy_hook_adapter.py Stop bash ./hooks/commit-on-stop/commit-on-stop.sh",
        "timeout": 30,
        "type": "command"
      }
    ],
    "enabled": true
  },
  "kill-switch": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 ./hooks/_agy_hook_adapter.py PreToolUse bash ./hooks/kill-switch/kill-switch.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "enabled": true
  },
  "steer": {
    "PreInvocation": [
      {
        "command": "python3 ./hooks/_agy_hook_adapter.py UserPromptSubmit bash ./hooks/steer/steer.sh",
        "timeout": 5,
        "type": "command"
      }
    ],
    "enabled": true
  }
}
